# 開発用の設定の見本（値はすべてダミー）。`cp .env.example .env` して使う。
# .env はデバッグビルド（cargo run）のときだけ読まれる。本番は /etc/serversystem/env（deploy/env.example）。
APP_LISTEN=127.0.0.1:8081
# target/ の下に置くと git に入らない（.gitignore 済み）
APP_DATABASE_PATH=./target/dev.db
# Vite の開発サーバーのオリジン（Origin の確認に使う）
APP_PUBLIC_ORIGIN=http://localhost:5173
# http で試すので Secure を付けない
APP_COOKIE_SECURE=false
APP_SITE_GATE_ENABLED=true
# 合言葉の bcrypt ハッシュ（作り方: cargo run -- hash-password）。
# dotenvy は $ を変数として展開するので、単引用符で囲む（systemd の EnvironmentFile では不要）
SITE_PASSWORD_HASH='$2y$10$dummydummydummydummydummydummydummydummydummydummydummy'

DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET=dummy-client-secret
DISCORD_REDIRECT_URI=http://localhost:5173/api/v1/auth/discord/callback
DISCORD_GUILD_ID=000000000000000000

AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=dummy-secret-access-key
AWS_REGION=ap-northeast-1
EC2_LT_MINECRAFT=lt-0123456789abcdef0

RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000
# カンマ区切り。# の前が名前、後がタグ
LOL_MEMBERS=名前#JP1,名前2#TAG

RUNNING_API_BASE=https://xxxx.execute-api.ap-northeast-1.amazonaws.com
RUNNING_SHARED_SECRET=dummy-shared-secret
RUNNING_TIMEOUT_SECS=10

# 省略時は本物の URL
#DISCORD_API_BASE=
#RIOT_ACCOUNT_BASE=
#RIOT_PLATFORM_BASE=

# ログの細かさ（例: debug、serversystem=debug,tower_http=debug）
#RUST_LOG=info
